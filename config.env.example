# R2Drop configuration (non-secret)
# Copy this file to ${XDG_CONFIG_HOME:-~/.config}/r2drop/config.env and fill in your values.
#
# Secrets (CLOUDFLARE_R2_ACCESS_KEY_ID and CLOUDFLARE_R2_SECRET_ACCESS_KEY)
# belong in your environment or ykcred (service: image-hosting), NOT here.

CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_R2_BUCKET=""
CLOUDFLARE_R2_PUBLIC_URL="https://img.example.com"

# Output format copied to clipboard: url | markdown | html | markdown-filename
R2DROP_FORMAT="markdown"
